COMPOSE_PROJECT_NAME=sibklimat-production

# Public DNS names. Point both A/AAAA records to the deployment server first.
DEV_SITE_DOMAIN=dev.example.com
STRAPI_DOMAIN=cms.example.com

# Only loopback-bound diagnostic ports; public traffic goes through Caddy.
FRONTEND_BIND_ADDRESS=127.0.0.1
FRONTEND_HOST_PORT=3000
STRAPI_BIND_ADDRESS=127.0.0.1
STRAPI_HOST_PORT=1337

STRAPI_PUBLIC_URL=https://cms.example.com
STRAPI_IS_PROXIED=true
STRAPI_CORS_ORIGINS=https://dev.example.com

NUXT_PUBLIC_SITE_URL=https://dev.example.com
NUXT_PUBLIC_SITE_INDEXABLE=false
NUXT_STRAPI_URL=http://strapi:1337
NUXT_PUBLIC_STRAPI_URL=https://cms.example.com
NUXT_STRAPI_API_TOKEN=

NUXT_PUBLIC_SMART_CAPTCHA_SITE_KEY=
NUXT_SMART_CAPTCHA_SERVER_KEY=

NUXT_TELEGRAM_BOT_TOKEN=
NUXT_TELEGRAM_CHAT_ID=

# Optional outbound HTTPS proxy for server-side fetch (for example Telegram).
# Keep internal Strapi and SmartCaptcha direct through NUXT_NO_PROXY.
NUXT_USE_ENV_PROXY=
NUXT_HTTPS_PROXY=
NUXT_NO_PROXY=strapi,localhost,127.0.0.1,smartcaptcha.cloud.yandex.ru

NUXT_LEAD_RATE_LIMIT_MAX=5
NUXT_LEAD_RATE_LIMIT_WINDOW_MS=600000

# Generate unique production values; never copy development placeholders.
STRAPI_APP_KEYS=replace-key-1,replace-key-2,replace-key-3,replace-key-4
STRAPI_API_TOKEN_SALT=replace-with-random-api-token-salt
STRAPI_ADMIN_JWT_SECRET=replace-with-random-admin-jwt-secret
STRAPI_TRANSFER_TOKEN_SALT=replace-with-random-transfer-token-salt
STRAPI_JWT_SECRET=replace-with-random-jwt-secret
STRAPI_ENCRYPTION_KEY=replace-with-random-encryption-key-at-least-32-chars
