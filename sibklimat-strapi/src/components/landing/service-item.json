{
  "collectionName": "components_landing_service_items",
  "info": {
    "displayName": "Service Item",
    "description": "Service card with icon, image and selling points"
  },
  "options": {},
  "attributes": {
    "slug": {
      "type": "string",
      "required": true
    },
    "iconKey": {
      "type": "enumeration",
      "enum": [
        "home",
        "building",
        "factory",
        "wind",
        "wrench",
        "settings"
      ],
      "required": true
    },
    "chip": {
      "type": "string",
      "required": true,
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "title": {
      "type": "string",
      "required": true,
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "description": {
      "type": "text",
      "required": true,
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "image": {
      "type": "media",
      "multiple": false,
      "allowedTypes": [
        "images"
      ],
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "imageAlt": {
      "type": "string",
      "required": true,
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "points": {
      "type": "component",
      "repeatable": true,
      "component": "shared.text-item",
      "required": true,
      "min": 1,
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    }
  },
  "config": {}
}
