{
  "collectionName": "components_layout_headers",
  "info": {
    "displayName": "Header",
    "description": "Landing page header content"
  },
  "options": {},
  "attributes": {
    "logo": {
      "type": "media",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      },
      "multiple": false,
      "allowedTypes": [
        "images"
      ]
    },
    "logoAlt": {
      "type": "string",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "brand": {
      "type": "string",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      },
      "required": true
    },
    "brandHref": {
      "type": "string",
      "default": "#top",
      "required": true
    },
    "tagline": {
      "type": "string",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      },
      "required": true
    },
    "navigation": {
      "type": "component",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      },
      "component": "layout.navigation-item",
      "repeatable": true,
      "required": true,
      "min": 1
    },
    "ctaLabel": {
      "type": "string",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      },
      "required": true
    },
    "ctaHref": {
      "type": "string",
      "default": "#contact",
      "required": true
    }
  },
  "config": {}
}
